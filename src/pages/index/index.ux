<template>
  <div class="app">
    <image class="title" src="/common/txt/title.png"></image>
    <div class="row">
      <image class="lbl" src="/common/txt/lbl_tarih.png"></image>
      <div class="val"><image class="g" for="{{ tarihRow }}" src="{{ $item }}"></image></div>
    </div>
    <div class="row">
      <image class="lbl" src="/common/txt/lbl_saat.png"></image>
      <div class="val"><image class="g" for="{{ saatRow }}" src="{{ $item }}"></image></div>
    </div>
    <div class="row">
      <image class="lbl" src="/common/txt/lbl_dilim.png"></image>
      <div class="val"><image class="g" for="{{ dilimRow }}" src="{{ $item }}"></image></div>
    </div>
    <div class="row">
      <image class="lbl" src="/common/txt/lbl_unix.png"></image>
      <div class="val"><image class="g" for="{{ unixRow }}" src="{{ $item }}"></image></div>
    </div>
  </div>
</template>

<script>
// Minimal time PoC.
//
// Shows only data every Vela quick app can read everywhere: the device clock.
//   Tarih  - local date            e.g. 2026-10-18
//   Saat   - local time            e.g. 14:23:05
//   Dilim  - UTC offset            e.g. UTC+03:00
//   Unix   - unix timestamp (s)    e.g. 1760797385
//
// Text is image-based: the Redmi Watch 4 runtime cannot draw <text> glyphs, so
// every string is composed from pre-rendered glyph PNGs (scripts/gen_assets.py)
// via the `for` directive, one <image> per character.

function glyphs(s) {
  const out = []
  const str = String(s)
  for (let i = 0; i < str.length; i++) {
    out.push('/common/txt/g_' + str.charCodeAt(i).toString(16) + '.png')
  }
  return out
}

function pad2(n) {
  return n < 10 ? '0' + n : '' + n
}

export default {
  private: {
    tarihRow: [],
    saatRow: [],
    dilimRow: [],
    unixRow: []
  },

  onInit() {
    this._timer = null
    this._tick()
  },

  onShow() {
    this._tick()
    if (!this._timer) {
      this._timer = setInterval(() => this._tick(), 1000)
    }
  },

  onHide() {
    this._stopTimer()
  },

  onDestroy() {
    this._stopTimer()
  },

  _stopTimer() {
    if (this._timer) {
      clearInterval(this._timer)
      this._timer = null
    }
  },

  _tick() {
    const d = new Date()
    this.tarihRow = glyphs(d.getFullYear() + '-' +
      pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()))
    this.saatRow = glyphs(pad2(d.getHours()) + ':' +
      pad2(d.getMinutes()) + ':' + pad2(d.getSeconds()))
    const mins = -d.getTimezoneOffset()
    const sign = mins < 0 ? '-' : '+'
    const abs = Math.abs(mins)
    this.dilimRow = glyphs('UTC' + sign +
      pad2(Math.floor(abs / 60)) + ':' + pad2(abs % 60))
    this.unixRow = glyphs(Math.floor(d.getTime() / 1000))
  }
}
</script>

<style>
.app {
  width: 390px;
  height: 450px;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  padding-left: 16px;
  padding-top: 44px;
  background-color: #000000;
}

.title {
  width: 310px;
  height: 42px;
  margin-left: 4px;
  margin-bottom: 18px;
}

.row {
  width: 360px;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  margin-bottom: 16px;
}

.lbl {
  width: 150px;
  height: 25px;
  margin-left: 4px;
}

.val {
  width: 348px;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  margin-left: 4px;
}

.g {
  width: 16px;
  height: 22px;
}
</style>
